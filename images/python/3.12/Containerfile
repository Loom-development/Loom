ARG LOOM_BASE_IMAGE
FROM ${LOOM_BASE_IMAGE}

RUN set -eux; \
    apt-get update; \
    apt-get install --yes --no-install-recommends \
        build-essential \
        default-libmysqlclient-dev \
        git \
        libffi-dev \
        libjpeg62-turbo-dev \
        libpq-dev \
        libsqlite3-dev \
        libssl-dev \
        pkg-config \
        zlib1g-dev; \
    rm -rf /var/lib/apt/lists/*

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /workspace

CMD ["python3"]
