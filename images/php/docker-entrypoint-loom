#!/usr/bin/env bash
set -euo pipefail

if [[ "${1:-}" == "apache2-foreground" ]]; then
  case "${LOOM_DOCUMENT_ROOT:-}" in
    /*) ;;
    *)
      printf 'LOOM_DOCUMENT_ROOT must be an absolute path, got %q\n' \
        "${LOOM_DOCUMENT_ROOT:-}" >&2
      exit 64
      ;;
  esac

  escaped_document_root="${LOOM_DOCUMENT_ROOT//&/\\&}"
  escaped_document_root="${escaped_document_root//|/\\|}"
  sed -ri \
    "s|/var/www/html|${escaped_document_root}|g" \
    /etc/apache2/sites-available/*.conf \
    /etc/apache2/apache2.conf \
    /etc/apache2/conf-available/*.conf
fi

exec docker-php-entrypoint "$@"
