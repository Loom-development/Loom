MYSQL_ROOT_PASSWORD=loomroot
MYSQL_DATABASE=loom
MYSQL_USER=loom
MYSQL_PASSWORD=loom
MYSQL_URL=mysql://loom:loom@mysql:3306/loom

MSSQL_SA_PASSWORD=LoomDev!Passw0rd
